{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window may call only the app's own commands, each listed explicitly. No core:* permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-agent-status",
    "allow-list-downloads",
    "allow-get-snapshot",
    "allow-get-download",
    "allow-enqueue-url",
    "allow-pause",
    "allow-resume",
    "allow-cancel",
    "allow-retry",
    "allow-remove",
    "allow-start-engine",
    "allow-stop-engine",
    "allow-show-in-folder",
    "allow-pause-all",
    "allow-resume-all",
    "allow-update-limits",
    "allow-update-priority",
    "allow-get-limits"
  ]
}
